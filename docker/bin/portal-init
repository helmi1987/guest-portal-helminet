#!/bin/sh
# First-start and every-start initialisation. Runs as s6 oneshot before all services.
set -eu

APP_DIR=/var/www/html
DATA_DIR="${PORTAL_DATA_DIR:-/data}"
RUN_DIR=/run/portal
ENV_FILE="$DATA_DIR/.env"

log() { echo "[portal-init] $*"; }

mkdir -p "$DATA_DIR/db" "$DATA_DIR/certs" "$DATA_DIR/backups" "$DATA_DIR/radius" "$DATA_DIR/branding" \
    "$RUN_DIR" /run/nginx /run/php-fpm

# --- Secrets env file (generated once, persisted on the volume) -------------
if [ ! -f "$ENV_FILE" ]; then
    log "generating $ENV_FILE"
    umask 077
    {
        echo "# Generated on first start. Keep this file secret."
        echo "APP_KEY=base64:$(head -c 32 /dev/urandom | base64)"
        echo "INTERNAL_API_TOKEN=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')"
    } > "$ENV_FILE"
    umask 022
fi
grep -q '^INTERNAL_API_TOKEN=' "$ENV_FILE" || \
    echo "INTERNAL_API_TOKEN=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')" >> "$ENV_FILE"
ln -sf "$ENV_FILE" "$APP_DIR/.env"

# Values needed by non-PHP services (FreeRADIUS) are exported to a root-only file.
INTERNAL_API_TOKEN="$(sed -n 's/^INTERNAL_API_TOKEN=//p' "$ENV_FILE" | head -n1)"
umask 077
printf '%s' "$INTERNAL_API_TOKEN" > "$RUN_DIR/internal_api_token"
umask 022

# --- Database ----------------------------------------------------------------
if [ "${DB_CONNECTION:-sqlite}" = "sqlite" ]; then
    DB_FILE="${DB_DATABASE:-$DATA_DIR/db/database.sqlite}"
    [ -f "$DB_FILE" ] || { log "creating SQLite database"; touch "$DB_FILE"; }
fi

# --- TLS certificates (portal + router), see portal-certs ---------------------
/usr/local/bin/portal-certs

# --- nginx listener ports ------------------------------------------------------
sed -e "s/__GUEST_PORT__/${GUEST_PORT:-443}/g" \
    -e "s/__ADMIN_PORT__/${ADMIN_PORT:-8443}/g" \
    -e "s/__INTERNAL_PORT__/${INTERNAL_PORT:-8080}/g" \
    /etc/nginx/portal.conf.template > "$RUN_DIR/nginx-portal.conf"
# Some runtimes (e.g. containers without IPv6) cannot bind [::].
[ -f /proc/net/if_inet6 ] || sed -i '/listen \[::\]/d' "$RUN_DIR/nginx-portal.conf"

# --- FreeRADIUS clients file (rendered by Laravel, see portal:radius-clients) --
[ -f "$DATA_DIR/radius/clients.conf" ] || \
    echo "# Managed by the portal. Do not edit." > "$DATA_DIR/radius/clients.conf"

# --- Permissions -------------------------------------------------------------
chown -R portal:portal "$DATA_DIR/db" "$DATA_DIR/radius" "$DATA_DIR/branding"
# Backups contain secrets. The folder may be a bind mount (e.g. NAS share) that refuses chown/chmod.
{ chown -R portal:portal "$DATA_DIR/backups" && chmod 700 "$DATA_DIR/backups"; } 2>/dev/null \
    || log "WARNING: cannot set owner/mode of $DATA_DIR/backups (the app user portal must be able to write)"
chown portal:portal "$DATA_DIR" "$ENV_FILE"
chmod 600 "$ENV_FILE"

# --- Laravel -------------------------------------------------------------------
cd "$APP_DIR"
as_portal() { s6-setuidgid portal "$@"; }
# Drop caches from a previous start (cache:clear would need the DB before migrating).
as_portal php artisan config:clear >/dev/null
as_portal php artisan route:clear >/dev/null
as_portal php artisan migrate --force --no-interaction
as_portal php artisan portal:init
as_portal php artisan portal:radius-clients
as_portal php artisan optimize >/dev/null
log "done"
