# Single virtual server: auth and accounting on the standard ports.
server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        # Tell Laravel which router (client entry "nas-<id>") sent the request.
        update request {
            &FreeRADIUS-Client-Shortname := "%{client:shortname}"
        }
        rest
        if (updated) {
            # Accept decided by Laravel (one-time credentials checked there).
            update control {
                &Auth-Type := Accept
            }
        }
        else {
            reject
        }
    }

    authenticate {
    }

    preacct {
        update request {
            &FreeRADIUS-Client-Shortname := "%{client:shortname}"
        }
    }

    accounting {
        rest
    }

    # RouterOS >= 7.15 (require-message-auth) drops Accept/Reject without Message-Authenticator
    # (Blast-RADIUS). Adding the attribute makes FreeRADIUS calculate it for every reply.
    post-auth {
        update reply {
            &Message-Authenticator := 0x00
        }
        Post-Auth-Type REJECT {
            update reply {
                &Message-Authenticator := 0x00
            }
        }
    }
}
