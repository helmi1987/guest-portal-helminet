# Rendered at start by portal-init (ports from env). Each listener passes its zone to
# Laravel as a FastCGI parameter; the app only serves the routes of that zone.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Guest portal
server {
    listen __GUEST_PORT__ ssl;
    listen [::]:__GUEST_PORT__ ssl;
    http2 on;
    set $portal_zone guest;
    location ^~ /admin { return 404; }
    location ^~ /internal { return 404; }
    location ^~ /up { return 404; }
    include /etc/nginx/portal-app.conf;
}

# Admin UI
server {
    listen __ADMIN_PORT__ ssl;
    listen [::]:__ADMIN_PORT__ ssl;
    http2 on;
    set $portal_zone admin;
    location = / { return 302 /admin; }
    location ^~ /internal { return 404; }
    include /etc/nginx/portal-app.conf;
}

# Internal API (FreeRADIUS -> Laravel, healthcheck). Loopback only.
server {
    listen 127.0.0.1:__INTERNAL_PORT__;
    set $portal_zone internal;
    include /etc/nginx/portal-app.conf;
}
