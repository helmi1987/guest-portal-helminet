# Rendered at start by portal-init (ports from env). Each listener passes its zone to
# Laravel as a FastCGI parameter; the app only serves the routes of that zone.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Per-listener security headers (used by portal-headers.conf; an empty value sends no header).
# Guest pages: plain HTML with a few inline scripts (login handoff auto-submit, WebOTP, "sign in
# again" link), no inline styles (branding CSS is a same-origin stylesheet), images and fonts from
# the portal or embedded data: URLs (custom CSS). The handoff form posts to the router's hotspot
# login URL (https, host from the site's hotspot host names), so form-action allows any https: host.
# Admin UI: Livewire 3 with Alpine evaluates expressions at runtime ('unsafe-eval'), inline
# onsubmit/onclick handlers and Livewire's injected styles need 'unsafe-inline'.
# HSTS only on the browser-facing TLS listeners (no includeSubDomains, no preload).
# Framing: no page may be framed, except the guest text preview of the admin UI, which the admin page
# itself shows in an iframe (CONCEPT.md §9 "Guest texts", §12). Matched on the original request URI, so
# the internal redirect to index.php does not change the decision.
map "$portal_zone:$request_uri" $portal_frame_self {
    "~^admin:/admin/texts/preview(\?|$)" 1;
    default 0;
}
map $portal_frame_self $portal_frame_ancestors {
    1 "'self'";
    default "'none'";
}
map $portal_frame_self $portal_frame_options {
    1 "SAMEORIGIN";
    default "DENY";
}
map $portal_zone $portal_csp_zone {
    guest "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'";
    admin "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors $portal_frame_ancestors";
    default "";
}
# The app's own policy wins (uploaded branding files are served with a stricter one).
map $upstream_http_content_security_policy $portal_csp {
    "" $portal_csp_zone;
    default "";
}
map $upstream_http_x_content_type_options $portal_nosniff {
    "" "nosniff";
    default "";
}
map $portal_zone $portal_hsts {
    guest "max-age=31536000";
    admin "max-age=31536000";
    default "";
}

# Guest portal
server {
    listen __GUEST_PORT__ ssl;
    listen [::]:__GUEST_PORT__ ssl;
    http2 on;
    set $portal_zone guest;
    location ^~ /admin { return 404; }
    location ^~ /internal { return 404; }
    location ^~ /up { return 404; }
    location ^~ /livewire { return 404; }
    include /etc/nginx/portal-app.conf;
}

# Admin UI
server {
    listen __ADMIN_PORT__ ssl;
    listen [::]:__ADMIN_PORT__ ssl;
    http2 on;
    set $portal_zone admin;
    location = / { return 302 /admin; }
    location ^~ /internal { return 404; }
    location ^~ /up { return 404; }
    include /etc/nginx/portal-app.conf;
}

# __FEDERATION_BEGIN__ (removed by portal-init when the federation certificate is missing)
# Federation API between instances (CONCEPT.md §10.2): mTLS with the instance's own self-signed
# certificate. Every peer must present its certificate; it is not checked against a CA here
# (optional_no_ca), Laravel compares its public key pin (SPKI sha256) with instances.cert_fingerprint.
# Only /federation/... is served.
server {
    listen __FEDERATION_PORT__ ssl;
    listen [::]:__FEDERATION_PORT__ ssl;
    ssl_certificate /run/portal/federation.crt;
    ssl_certificate_key /run/portal/federation.key;
    ssl_verify_client optional_no_ca;
    root /var/www/html/public;
    add_header X-Content-Type-Options "nosniff" always;

    location / { return 404; }
    location ^~ /federation/ { rewrite ^ /index.php last; }
    location = /index.php {
        internal;
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param PORTAL_ZONE federation;
        fastcgi_param PORTAL_CLIENT_CERT $ssl_client_escaped_cert;
        fastcgi_param HTTP_PROXY "";
    }
}
# __FEDERATION_END__

# Internal API (FreeRADIUS -> Laravel, healthcheck). Loopback only.
server {
    listen 127.0.0.1:__INTERNAL_PORT__;
    set $portal_zone internal;
    include /etc/nginx/portal-app.conf;
}
