# Rendered at start by portal-init (ports from env). Each listener passes its zone to
# Laravel as a FastCGI parameter; the app only serves the routes of that zone.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Guest portal
server {
    listen __GUEST_PORT__ ssl;
    listen [::]:__GUEST_PORT__ ssl;
    http2 on;
    set $portal_zone guest;
    location ^~ /admin { return 404; }
    location ^~ /internal { return 404; }
    location ^~ /up { return 404; }
    location ^~ /livewire { return 404; }
    include /etc/nginx/portal-app.conf;
}

# Admin UI
server {
    listen __ADMIN_PORT__ ssl;
    listen [::]:__ADMIN_PORT__ ssl;
    http2 on;
    set $portal_zone admin;
    location = / { return 302 /admin; }
    location ^~ /internal { return 404; }
    location ^~ /up { return 404; }
    include /etc/nginx/portal-app.conf;
}

# Federation API between instances (CONCEPT.md §10.2): mTLS with the instance's own self-signed
# certificate. Every peer must present its certificate; it is not checked against a CA here
# (optional_no_ca), Laravel compares its public key pin (SPKI sha256) with instances.cert_fingerprint.
# Only /federation/... is served.
server {
    listen __FEDERATION_PORT__ ssl;
    listen [::]:__FEDERATION_PORT__ ssl;
    ssl_certificate /run/portal/federation.crt;
    ssl_certificate_key /run/portal/federation.key;
    ssl_verify_client optional_no_ca;
    root /var/www/html/public;
    add_header X-Content-Type-Options "nosniff" always;

    location / { return 404; }
    location ^~ /federation/ { rewrite ^ /index.php last; }
    location = /index.php {
        internal;
        fastcgi_pass unix:/run/php-fpm/php-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param PORTAL_ZONE federation;
        fastcgi_param PORTAL_CLIENT_CERT $ssl_client_escaped_cert;
        fastcgi_param HTTP_PROXY "";
    }
}

# Internal API (FreeRADIUS -> Laravel, healthcheck). Loopback only.
server {
    listen 127.0.0.1:__INTERNAL_PORT__;
    set $portal_zone internal;
    include /etc/nginx/portal-app.conf;
}
